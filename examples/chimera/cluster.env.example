# Copy this file outside the repository and edit it for one concrete run.

# Training stage: pretrain, sft, or simpo.
STAGE=pretrain
RUN_NAME=chimera_pretrain_phase1

# Nodes are assigned ranks in this order. The first node is the default master.
NODES_CSV=dgx11,dgx12,dgx13,dgx14,dgx15,dgx16
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500

# Host paths shared at the same location on every node.
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/surya/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/surya/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/surya/chimera/data

# Container image and canonical container paths.
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
RUNS_ROOT=/datasets/megadata/runs/pretrain

# Pretraining inputs. Paths are prefixes without .bin or .idx.
TRAIN_DATA_PATH=/datasets/megadata/pretrain/train_text_document
VALID_DATA_PATH=/datasets/megadata/pretrain/valid_text_document
LOAD_CHECKPOINT=

# SFT or SimPO input and initial model checkpoint.
DATA_PATH=/datasets/megadata/sft/train.jsonl
MCORE_PATH=/datasets/megadata/checkpoints/pretrain

# Cluster-dependent training values. These are the six-node pretraining defaults.
# For SFT or SimPO, start with MICRO_BATCH_SIZE=1 and GLOBAL_BATCH_SIZE=96.
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
MICRO_BATCH_SIZE=4
GLOBAL_BATCH_SIZE=576

# Runtime controls.
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200
