# Copy outside the repository and edit only this file for YaRN context extension.

# Common cluster, mounts, topology, and optimizer.
STAGE=context_extension
RUN_NAME=chimera_context_128k
NODES_CSV=dgx11,dgx12,dgx13,dgx14,dgx15,dgx16
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/chimera/data
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
OPTIMIZER=adam
MUON_NUM_NS_STEPS=6
MAIN_GRADS_DTYPE=fp32
EXP_AVG_DTYPE=fp32
EXP_AVG_SQ_DTYPE=fp32
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200

# Direct 8K-to-128K extension is allowed when LOAD_CHECKPOINT is an 8K run.
RUNS_ROOT=/datasets/megadata/runs/context_extension
TRAIN_DATA_PATH=/datasets/megadata/pretrain/train_text_document
# Optional prefix (without .bin/.idx). Blank disables validation.
VALID_DATA_PATH=
LOAD_CHECKPOINT=/datasets/megadata/checkpoints/pretrain
INTRA_DOC_MASKING=false
CONTEXT_PHASE=128k
SEQ_LENGTH=131072
MICRO_BATCH_SIZE=1
GLOBAL_BATCH_SIZE=48
TRAIN_TOKENS=10000000000
TRAIN_ITERS=
# At DP=48 this resolves to 1,590 updates, 159 warmup, 159 save, 80 eval.
LR=1e-5
MIN_LR=
MIN_LR_RATIO=0.1
LR_DECAY_STYLE=cosine
LR_DECAY_FRACTION=1.0
LR_WARMUP_FRACTION=0.10
LR_WSD_DECAY_FRACTION=0.10
LR_WSD_DECAY_STYLE=linear
WEIGHT_DECAY=0.1
SAVE_INTERVAL=
SAVE_INTERVAL_FRACTION=0.10
EVAL_INTERVAL=
EVAL_INTERVAL_FRACTION=0.05
EVAL_ITERS=4
LOG_INTERVAL=1
NUM_WORKERS=8
