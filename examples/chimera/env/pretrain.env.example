# Copy outside the repository and edit only this file for an 8K pretraining run.

# Common cluster, mounts, topology, and optimizer.
STAGE=pretrain
RUN_NAME=chimera_pretrain_8k_440b
NODES_CSV=dgx11,dgx12,dgx13,dgx14,dgx15,dgx16
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/surya/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/surya/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/surya/chimera/data
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
OPTIMIZER=adam
MUON_NUM_NS_STEPS=6
MAIN_GRADS_DTYPE=fp32
EXP_AVG_DTYPE=fp32
EXP_AVG_SQ_DTYPE=fp32
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200

# 8K pretraining data, duration, and schedule.
RUNS_ROOT=/datasets/megadata/runs/pretrain
TRAIN_DATA_PATH=/datasets/megadata/pretrain/train_text_document
VALID_DATA_PATH=/datasets/megadata/pretrain/valid_text_document
LOAD_CHECKPOINT=
INTRA_DOC_MASKING=false
CONTEXT_PHASE=8k
SEQ_LENGTH=8192
MICRO_BATCH_SIZE=2
GLOBAL_BATCH_SIZE=576
TRAIN_TOKENS=440000000000
TRAIN_ITERS=
# At DP=48 this resolves to 93,249 updates, 467 warmup, 2,332 save, 467 eval.
LR=3e-4
MIN_LR=
MIN_LR_RATIO=0.01
LR_DECAY_STYLE=cosine
LR_DECAY_FRACTION=1.0
LR_WARMUP_FRACTION=0.005
LR_WSD_DECAY_FRACTION=0.10
LR_WSD_DECAY_STYLE=linear
WEIGHT_DECAY=0.1
SAVE_INTERVAL=
SAVE_INTERVAL_FRACTION=0.025
EVAL_INTERVAL=
EVAL_INTERVAL_FRACTION=0.005
EVAL_ITERS=4
LOG_INTERVAL=1
NUM_WORKERS=8
