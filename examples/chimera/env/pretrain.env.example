# Copy outside the repository and edit only this file for an 8K pretraining run.

# Common cluster, mounts, topology, and optimizer.
STAGE=pretrain
RUN_NAME=chimera_pretrain_8k_4t_muon_clip_5ns
NODES_CSV=dgx11,dgx12,dgx13,dgx14,dgx15,dgx16
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/chimera/data
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
OPTIMIZER=muon
MUON_MOMENTUM=0.95
MUON_NUM_NS_STEPS=5
MUON_SCALE_MODE=spectral
MUON_EXTRA_SCALE_FACTOR=0.2
MUON_SCALAR_OPTIMIZER=adam
MUON_SPLIT_QKV=true
MUON_NESTEROV=false
ADAM_BETA1=0.9
ADAM_BETA2=0.95
ADAM_EPS=1e-8
ATTENTION_BACKEND=fused
QK_LAYERNORM=true
QK_CLIP=true
QK_CLIP_THRESHOLD=100.0
QK_CLIP_ALPHA=0.5
LOG_MAX_ATTENTION_LOGIT=true
APPLY_ROPE_FUSION=true
FUSED_LINEAR_CROSS_ENTROPY=true
CLIP_GRAD=1.0
# Adam only: params=fp32|fp16, grads=fp32|bf16, moments=fp32|fp16|bf16|fp8.
# Muon/AdaMuon internal state remains FP32.
MAIN_PARAMS_DTYPE=fp32
MAIN_GRADS_DTYPE=fp32
EXP_AVG_DTYPE=fp32
EXP_AVG_SQ_DTYPE=fp32
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200

# 8K pretraining data, duration, and schedule.
RUNS_ROOT=/datasets/megadata/runs/pretrain
TRAIN_DATA_PATH=/datasets/megadata/pretrain/train_text_document
# Optional prefix (without .bin/.idx). Blank disables validation.
VALID_DATA_PATH=
LOAD_CHECKPOINT=
INTRA_DOC_MASKING=false
CONTEXT_PHASE=8k
SEQ_LENGTH=8192
MICRO_BATCH_SIZE=2
GLOBAL_BATCH_SIZE=576
TRAIN_TOKENS=4000000000000
TRAIN_ITERS=
# At DP=48 this resolves to 847,711 updates, 4,239 warmup, 21,193 save, 4,239 eval.
LR=3e-4
MIN_LR=2e-5
MIN_LR_RATIO=0.01
LR_DECAY_STYLE=cosine
LR_DECAY_FRACTION=1.0
LR_WARMUP_FRACTION=0.005
LR_WSD_DECAY_FRACTION=0.10
LR_WSD_DECAY_STYLE=linear
WEIGHT_DECAY=0.1
SAVE_INTERVAL=
SAVE_INTERVAL_FRACTION=0.025
EVAL_INTERVAL=
EVAL_INTERVAL_FRACTION=0.005
EVAL_ITERS=4
LOG_INTERVAL=1
NUM_WORKERS=32
