# Copy outside the repository and edit only this file for a SimPO run.

# Common cluster, mounts, topology, and optimizer.
STAGE=simpo
RUN_NAME=chimera_simpo_128k
NODES_CSV=dgx11,dgx12,dgx13,dgx14,dgx15,dgx16
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/surya/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/surya/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/surya/chimera/data
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
OPTIMIZER=adam
MUON_NUM_NS_STEPS=6
MAIN_GRADS_DTYPE=fp32
EXP_AVG_DTYPE=fp32
EXP_AVG_SQ_DTYPE=fp32
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200

# Packed SimPO. Blank metadata paths are generated beside each JSONL file.
RUNS_ROOT=/datasets/megadata/runs/simpo
DATA_PATH=/datasets/megadata/simpo/train.jsonl
VALID_DATA_PATH=/datasets/megadata/simpo/valid.jsonl
MCORE_PATH=/datasets/megadata/checkpoints/sft
CONTEXT_PHASE=128k
SEQ_LENGTH=32768
MICRO_BATCH_SIZE=1
GLOBAL_BATCH_SIZE=96
TRAIN_EPOCHS=1
TRAIN_ITERS=
LR=8e-7
MIN_LR=
MIN_LR_RATIO=0.1
LR_DECAY_STYLE=cosine
LR_DECAY_FRACTION=1.0
LR_WARMUP_FRACTION=0.10
LR_WSD_DECAY_FRACTION=0.10
LR_WSD_DECAY_STYLE=linear
WEIGHT_DECAY=0.0
SAVE_INTERVAL=
SAVE_INTERVAL_FRACTION=0.25
EVAL_INTERVAL=
EVAL_INTERVAL_FRACTION=0.10
EVAL_ITERS=10
LOG_INTERVAL=1
NUM_WORKERS=8
PREPARE_WORKERS=32
PACK_SAMPLES=true
PACK_METADATA_PATH=
VALID_PACK_METADATA_PATH=
SAVE_WEIGHTS_ONLY=false
FUSED_LINEAR_CROSS_ENTROPY=true
SIMPO_BETA=2.5
SIMPO_GAMMA=0.55
SIMPO_LOSS_TYPE=sigmoid
SIMPO_SFT_WEIGHT=0.0
