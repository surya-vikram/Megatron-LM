# Copy this file outside the repository and edit it for one concrete run.

# Training stage: pretrain, sft, or simpo.
STAGE=pretrain
RUN_NAME=chimera_pretrain_v1

# Nodes are assigned ranks in this order. The first node is the default master.
NODES_CSV=dgx11,dgx13
GPUS_PER_NODE=8
MASTER_ADDR=
MASTER_PORT=29500

# Host paths shared at the same location on every node.
CHIMERA_ROOT=/nvme_zone3/home/ekamai1/chimera
HOST_REPOS=/nvme_zone3/home/ekamai1/chimera/repos
HOST_DATA=/nvme_zone3/home/ekamai1/chimera/data

# Container image and canonical container paths.
IMAGE=suryavikram6/megatron-gemma:v2-fixed
CONTAINER_REPOS=/workspace/repos
CONTAINER_DATA=/datasets/megadata
TOKENIZER_MODEL=/datasets/megadata/hf_models/chimera-10b
RUNS_ROOT=/datasets/megadata/runs/pretrain

# Pretraining inputs. Paths are prefixes without .bin or .idx.
TRAIN_DATA_PATH=/datasets/megadata/pretrain/fineweb_edu_deduped/fineweb_edu_tokenized_text_document
VALID_DATA_PATH=
LOAD_CHECKPOINT=

# SFT or SimPO input and initial model checkpoint.
DATA_PATH=/datasets/megadata/sft/ultrachat_200k_train_sft.jsonl
MCORE_PATH=

# Cluster-dependent training values. Confirm these before production use.
TP_SIZE=1
PP_SIZE=1
EP_SIZE=1
CP_SIZE=1
MICRO_BATCH_SIZE=1
GLOBAL_BATCH_SIZE=48

# Runtime controls.
ENABLE_GPU=true
ENABLE_IB=true
NCCL_SOCKET_IFNAME=
NCCL_IB_HCA=mlx5
NCCL_DEBUG=WARN
ALLOW_BUSY_GPUS=false
INTRA_DOC_MASKING=false
FORCE=false
SKIP_PREFLIGHT=false
STOP_TIMEOUT=1800
SSH_CONNECT_TIMEOUT=10
TAIL_LINES=200
